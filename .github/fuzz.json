{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "event",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_event.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/event",
      "instrumentation": [
        {
          "module": "dbus_event_log.models",
          "functions": [
            "DBusEvent.to_dict",
            "DBusEvent.to_mqtt_payload"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "Dockerfile",
    "fuzz",
    "pyproject.toml",
    "requirements-docker-build.txt",
    "requirements-docker-cairo.txt",
    "requirements-docker.txt",
    "src",
    "uv.lock"
  ]
}
