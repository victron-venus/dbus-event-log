{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**",
    "requirements-docker.txt"
  ],
  "packageRules": [
    {
      "description": "Generated lock outputs are refreshed with their existing source workflow; their uv command headers are not supported by the pinned pip-compile manager.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-docker.txt"
      ],
      "enabled": false
    },
    {
      "description": "Generated locks are updated by pip-compile through their recorded source inputs; never edit the output pins independently.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".github/requirements-build.txt",
        "requirements-docker-build.txt"
      ],
      "enabled": false
    },
    {
      "description": "Container CI and the native build recipe require exactly the Python 3.14-slim tag; digest refreshes remain enabled.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14-slim$/"
    },
    {
      "description": "Preserve the explicitly named legacy Bandit 1.9.2 toolchain while allowing its transitive lock maintenance.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        ".github/requirements-bandit-1.9.2.in"
      ],
      "matchPackageNames": [
        "bandit"
      ],
      "allowedVersions": "==1.9.2"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-bandit-1.9.2.txt",
      ".github/requirements-build.txt",
      ".github/requirements-fuzz.txt",
      "requirements-docker-build.txt",
      "requirements-docker.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-build\\.txt$/",
      "/^requirements\\-docker\\-build\\.txt$/",
      "/^\\.github/requirements\\-bandit\\-1\\.9\\.2\\.txt$/",
      "/^\\.github/requirements\\-fuzz\\.txt$/"
    ]
  },
  "pep621": {
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-bandit-1.9.2.txt",
      ".github/requirements-fuzz.txt",
      "requirements-docker.txt",
      "pyproject.toml"
    ]
  },
  "description": [
    "Root Python project updates require the documented uv lock and uv export sequence. Native pep621 only regenerates uv.lock, so this exact project stays on its coupled source workflow; independent dependency managers remain automated."
  ]
}
